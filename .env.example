LLM_PROVIDER=groq

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ---------------------------------------------------------------------------
# Email sending (SMTP)
# Choose gmail, zoho, or custom. Provider defaults:
#   gmail  -> smtp.gmail.com:465 (SSL)
#   zoho   -> smtp.zoho.com:465 (SSL)
#   custom -> set SMTP_HOST / SMTP_PORT / SMTP_SECURITY yourself
# ---------------------------------------------------------------------------
SMTP_PROVIDER=zoho
SMTP_USER=your_zoho_address@yourdomain.com
SMTP_PASSWORD=your_zoho_app_password
SENDER_NAME=Team

# Public URL of the deployed app (no trailing slash). Used to build
# one-click unsubscribe links in outgoing email. Set this in production.
APP_BASE_URL=https://your-app.vercel.app

# Optional DKIM selector when your provider uses a custom one
# (Zoho usually shows it in Mail Admin > Email Authentication > DKIM).
# DKIM_SELECTOR=zoho

# Optional overrides (uncomment only if needed).
# Regional Zoho hosts: smtp.zoho.in | smtp.zoho.eu | smtp.zoho.com.au | smtp.zoho.jp
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl          # ssl (465) or starttls (587)

# Sending from your own domain through any SMTP host: use provider "custom" and
# fill in the five values your mailbox host gives you.
# SMTP_PROVIDER=custom
# SMTP_HOST=smtp.yourdomain.com        # or mail.yourdomain.com / smtp.yourhost.com
# SMTP_PORT=587                        # 465 for SSL, 587 for STARTTLS
# SMTP_SECURITY=starttls               # ssl (465) or starttls (587)
# SMTP_USER=you@yourdomain.com         # full mailbox address; becomes the From header
# SMTP_PASSWORD=your_smtp_password     # app password if your host requires one
# Also publish SPF, DKIM, and DMARC for yourdomain.com before the first send;
# the campaign console's DNS check shows the exact records to add.

DAILY_LIMIT=15

# Legacy Gmail credentials — only used when SMTP_PROVIDER=gmail.
# GMAIL_USER=your_gmail_address
# GMAIL_APP_PASSWORD=your_gmail_app_password

# Dashboard sign-in (enforced when both values are set).
APP_EMAIL=admin@yourcompany.com
APP_PASSWORD=choose_a_long_password
# Optional: signs session cookies. Falls back to APP_PASSWORD when unset.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Campaign console (Google Sheets + durable queue)
# ---------------------------------------------------------------------------
# Encrypts sender SMTP passwords and OAuth tokens at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Falls back to SESSION_SECRET when unset.
# SENDER_CREDENTIAL_KEY=
# (a) You rotated a custom SESSION_SECRET: set the old value here (comma-separate several).
# (b) You never set SESSION_SECRET: leave this unset and rotate + re-save sender passwords instead;
#     the built-in fallback is public, so credentials written with it are compromised.
# SENDER_CREDENTIAL_KEY_LEGACY=

# Recommended warm-up defaults for new campaigns.
DEFAULT_HOURLY_LIMIT=8
DEFAULT_DAILY_LIMIT=40
DEFAULT_MIN_DELAY_MINUTES=4
DEFAULT_MAX_DELAY_MINUTES=12
DEFAULT_WINDOW_START=9
DEFAULT_WINDOW_END=18
CAMPAIGN_TIMEZONE=UTC

# In-process worker (disable on Vercel; Vercel Cron calls /api/queue/tick).
QUEUE_WORKER_ENABLED=true
QUEUE_TICK_SECONDS=30
QUEUE_MAX_PER_TICK=10
# Shared secret for /api/queue/tick and /api/outreach/webhook. On Vercel,
# set CRON_SECRET and Vercel sends it as "Authorization: Bearer <secret>".
CRON_SECRET=choose_a_long_random_value
# QUEUE_TICK_SECRET=   # optional override for CRON_SECRET

# Google Sheets ingestion: either share the sheet as "Anyone with the link"
# (public CSV export works with no credentials), or configure a service
# account and share the sheet with its client_email as a Viewer.
# GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# GOOGLE_SHEETS_API_KEY=optional_api_key

# Optional data directory override (defaults to .local-data locally and
# /tmp/email-automation-data on Vercel). Use a persistent database in production.
# DATA_DIR=
