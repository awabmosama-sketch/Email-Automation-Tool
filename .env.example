LLM_PROVIDER=groq

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ---------------------------------------------------------------------------
# Email sending (SMTP)
# Choose gmail, zoho, or custom. Provider defaults:
#   gmail  -> smtp.gmail.com:465 (SSL)
#   zoho   -> smtp.zoho.com:465 (SSL)
#   custom -> set SMTP_HOST / SMTP_PORT / SMTP_SECURITY yourself
# ---------------------------------------------------------------------------
SMTP_PROVIDER=zoho
SMTP_USER=your_zoho_address@yourdomain.com
SMTP_PASSWORD=your_zoho_app_password
SENDER_NAME=Team

# Public URL of the deployed app (no trailing slash). Used to build
# one-click unsubscribe links in outgoing email. Set this in production.
APP_BASE_URL=https://your-app.vercel.app

# Optional DKIM selector when your provider uses a custom one
# (Zoho usually shows it in Mail Admin > Email Authentication > DKIM).
# DKIM_SELECTOR=zoho

# Optional overrides (uncomment only if needed).
# Regional Zoho hosts: smtp.zoho.in | smtp.zoho.eu | smtp.zoho.com.au | smtp.zoho.jp
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl          # ssl (465) or starttls (587)

DAILY_LIMIT=5

# Legacy Gmail credentials — only used when SMTP_PROVIDER=gmail.
# GMAIL_USER=your_gmail_address
# GMAIL_APP_PASSWORD=your_gmail_app_password

# Dashboard sign-in (enforced when both values are set).
APP_EMAIL=admin@yourcompany.com
APP_PASSWORD=choose_a_long_password
# Optional: signs session cookies. Falls back to APP_PASSWORD when unset.
SESSION_SECRET=